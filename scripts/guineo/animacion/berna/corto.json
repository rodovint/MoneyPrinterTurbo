  ],
  [
   24.15,
   30.0,
   "Penal para cada lado, un gol de Julinho, y el árbitro Arthur Ellis perdiendo el control."
  ],
  [
   31.1,
   33.65,
   "Tres expulsados, y la policía metida en la cancha."
  ],
  [
   34.45,
   37.2,
   "¿Ese partido se terminaría hoy? Te leo."
  ],
  [
