 "subtitulos": [
  [
   3.95,
   10.1,
   "En 1954, un Mundial tuvo un partido tan violento que lo bautizaron como una batalla."
  ],
  [
   11.35,
   16.8,
   "Hungría, los Magiares Mágicos, contra Brasil, en Berna, en una cancha embarrada."
  ],
  [
   17.6,
   23.25,
