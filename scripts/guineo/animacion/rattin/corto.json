  ],
  [
   23.08,
   26.85,
   "Pidió un traductor. El partido estuvo parado casi 10 minutos."
  ],
  [
   27.28,
   30.0,
   "¿Tú te hubieras ido? Te leo."
  ],
  [
   30.6,
   36.15,
   "Al final salió escoltado por la policía… y dicen que antes se sentó en la alfombra roja de la reina."
  ],
  [
   37.38,
   41.65,
   "Camino al vestuario, estrujó el banderín del córner con la bandera del Reino Unido."
  ],
  [
   41.94,
   46.95,
